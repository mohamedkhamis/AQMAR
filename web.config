<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS site config for the AQMAR admin portal (FastAPI under uvicorn).

  How it works: the IIS HttpPlatformHandler module spawns a child Python
  process at app-pool start (one per worker), passing %HTTP_PLATFORM_PORT%
  which IIS picks at random from the dynamic range. uvicorn binds to
  127.0.0.1 on that port; IIS forwards external traffic to it.

  Requires:
    - HttpPlatformHandler installed (download from iis.net)
    - The app pool identity (default: IIS APPPOOL\<sitename>) must have:
        * Read + Execute on this directory tree
        * Full Control on logs\ + data\
        * A SQL Server login + db_owner on the aqmar database
    - .venv\Scripts\python.exe must exist (the project's virtualenv)
-->
<configuration>
  <system.webServer>
    <handlers>
      <!-- Hand every request (path=*, verb=*) to httpPlatformHandler — the
           module bridges IIS to the spawned Python process. -->
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified" />
    </handlers>

    <httpPlatform
        processPath="D:\Repo\01-Khamis-Projects\AQMAR\.venv\Scripts\python.exe"
        arguments="-m uvicorn src.admin_app:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT% --log-level info"
        stdoutLogEnabled="true"
        stdoutLogFile="D:\Repo\01-Khamis-Projects\AQMAR\logs\iis_stdout"
        startupTimeLimit="60"
        requestTimeout="00:04:00"
        forwardWindowsAuthToken="false">
      <environmentVariables>
        <!-- Match the same UTF-8 + unbuffered output we use for the daily script
             so Arabic logs don't crash cp1252 and stdout flushes promptly to the
             IIS log file. -->
        <environmentVariable name="PYTHONIOENCODING" value="utf-8" />
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_2FA_PASSWORD=
CHANNEL_USERNAME=AqmarTofan
SESSION_PATH=session/aqmar
DAILY_RUN_HOUR=9
# SQL Server (local) — canonical data backend as of 2026-05-17.
# Default for Windows + SQL Server with default instance + Windows Auth:
SQLSERVER_CONN_STR=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=aqmar;Trusted_Connection=yes;TrustServerCertificate=yes

# Admin API shared secret. The admin SPA sends this as `X-Admin-Token` on
# write endpoints. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- two-repo publishing (nightly automation) ---
# Public site repo (receives ONLY site files) + local clone location.
SITE_REPO_URL=https://github.com/mohamedkhamis/AQMAR.git
SITE_REPO_DIR=..\AQMAR-site

# deploy/vps/.env.vps.example
#
# Template for the VPS .env. Copy your LOCAL .env to the VPS and reconcile it
# against this file. Most values carry over unchanged; the notes below flag the
# few that matter for the VPS. The real .env lives at the REPO ROOT (C:\AQMAR\.env),
# is gitignored, and must never be committed.

# --- Telegram (carry over from local unchanged) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_2FA_PASSWORD=
CHANNEL_USERNAME=AqmarTofan
# Also hand-copy the session/ folder (or *.session) from local — it is the
# AUTHENTICATED login. Without it the scraper re-prompts for a login code,
# which a headless task cannot answer.
SESSION_PATH=session/aqmar
DAILY_RUN_HOUR=9

# --- SQL Server: stays localhost, because the DB now runs ON the VPS ---
# Windows auth: the IIS app pool and the scheduled-task service account each get
# their own login + db_owner (steps 6 + 7). No password in this string.
SQLSERVER_CONN_STR=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=aqmar;Trusted_Connection=yes;TrustServerCertificate=yes

# --- Admin API shared secret ---
# Generate a FRESH strong one for the public VPS; do not reuse the local dev
# token. The SPA sends it as X-Admin-Token on write endpoints.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- Publishing (nightly) ---
# `git push origin master` (done by publish_core.ps1) updates BOTH
# aqmar.pages.dev (Cloudflare Pages) and mohamedkhamis.github.io/AQMAR
# (GitHub Pages) — both build from master. That push IS the publish. It uses
# the task account's stored git credentials.
#
# Leave SITE_REPO_URL UNSET. publish_core.ps1 runs the separate two-repo
# site-sync ONLY when SITE_REPO_URL points at a repo DIFFERENT from origin;
# unset, the redundant second push is skipped cleanly.
# SITE_REPO_URL=
# SITE_REPO_DIR=..\AQMAR-site

# --- Email (Gmail app password) is NOT set here ---
# The nightly report email reads data/notify_settings.json (gitignored). Copy
# that file from local too, or re-enter it in the admin Settings page on the VPS.
